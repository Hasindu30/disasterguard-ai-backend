PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_very_strong_random_secret_key

# Your deployed frontend URL (for CORS) e.g. https://disasterguard.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# Optional: SMTP Email (for password reset via Nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM="DisasterGuard AI" <your_email@gmail.com>
